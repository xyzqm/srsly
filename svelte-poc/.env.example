# One of these must be set for /api/daily-content to generate passages.
SRSLY_API_KEY=your-api-key-here
ANTHROPIC_API_KEY=your-api-key-here

# Supabase. PUBLIC_SUPABASE_PUBLISHABLE_KEY is exposed to the browser (Dashboard -> Project
# Settings -> API -> Publishable key) and drives normal user sign-in/session auth.
# SUPABASE_SECRET_KEY is server-only (same section, Secret key) and bypasses RLS entirely — used
# solely by src/lib/server/definitions.ts to read/write the shared word_definitions cache table
# (see supabase-word-definitions.sql). Never expose the secret key to the client or commit it.
PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
SUPABASE_SECRET_KEY=your-secret-key-here
